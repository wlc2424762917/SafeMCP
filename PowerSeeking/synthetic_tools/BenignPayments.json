                        "message": {
                            "type": "string",
                            "description": "A message to include with the transfer"
                        }
                    },
                    "required": [
                        "email",
                        "amount",
                        "currency",
                        "message"
                    ]
                }
            },
            "category": "BenignPayments"
        },
