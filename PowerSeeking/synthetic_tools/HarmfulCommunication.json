            "function": {
                "name": "send_email",
                "description": "Send an email with the given message to a recipient.. A message indicating if the email was sent successfully or not.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "to": {
                            "type": "string",
                            "description": "The email of the recipient. Only one recipient is supported."
                        },
                        "subject": {
                            "type": "string",
                            "description": "The subject line of the email (optional)."
                        },
                        "body": {
                            "type": "string",
                            "description": "The message to be sent in the body of the email."
                        },
                        "attachments": {
                            "type": "array",
                            "description": "List of files you want to attach to the email (optional).",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "required": [
                        "to",
                        "subject",
                        "body",
                        "attachments"
                    ]
                }
            },
            "category": "HarmfulCommunication"
        },
